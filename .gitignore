# 忽略所有 .pth 后缀的文件（模型权重文件）
*.pth

# 忽略 model 文件夹（整个文件夹都不上传）
/model/
/docker/model/
/8bi2_train_model/
/100%train_model/
/train/
# 可选：忽略其他常见不需要上传的文件/文件夹
# Python 缓存文件
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境
venv/
env/
*.env

# 日志文件
*.log

# 临时文件
*.tmp
*.temp

# Docker 相关（如果不需要上传）
/docker/.env
/docker/build/

# Windows 系统文件
Thumbs.db
.DS_Store